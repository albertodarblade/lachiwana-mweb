{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "md3-docs": {
        "type": "local",
        "command": ["npx", "-y", "md3-docs-mcp@latest"],
        "timeout": 45000
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "agent": {
    "build": {
        "permission": {
          "bash": {
            "*": "allow"
          },
          "external_directory": {
            "../Lachiwana-service/**": "allow"
          }
        }
      },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "explore": {
      "permission": {
        "external_directory": {
          "../Lachiwana-service/**": "allow"
        }
      }
    },
    "general": {
      "permission": {
        "external_directory": {
          "../Lachiwana-service/**": "allow"
        }
      }
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "../Lachiwana-service/**": "allow"
    }
  },
  "formatter": true,
  "instructions": [
    "AGENTS.md",
    "specs/015-sliding-session-auth/plan.md"
  ]
}
